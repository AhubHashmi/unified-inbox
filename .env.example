# Shared team login (single password for everyone, per current scope)
SHARED_LOGIN_PASSWORD=

# Random long string used to sign session cookies
SESSION_SECRET=

# Appnality — reads ai-website-builder's WhatsApp tables directly
APPNALITY_DATABASE_URL=

# Booknality — reads its live Neon Postgres database
BOOKNALITY_DATABASE_URL=

# Taxnality, Explainedit, Buildbee, Blitzlabs, Ranknality: no adapter yet.
# They show as "not connected yet" until an adapter is written for them.

# Booknality human takeover: agent replies + AI on/off go through the Booknality backend.
# Base URL of the Booknality WhatsApp backend, and its AGENT_API_KEY (server-side only).
BOOKNALITY_API_BASE_URL=
BOOKNALITY_AGENT_API_KEY=
